{
  "name": "localtube-downloader",
  "version": "1.0.0",
  "description": "A production-quality local desktop GUI wrapper for yt-dlp and FFmpeg",
  "main": "dist/main/main.js",
  "author": "LocalTube Team",
  "license": "MIT",
  "scripts": {
    "dev": "npm run build:electron && concurrently -k -n \"VITE,MAIN\" -c \"blue,green\" \"vite\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "build:electron": "tsc -p tsconfig.main.json",
    "build:renderer": "vite build",
    "build": "npm run build:renderer && npm run build:electron",
    "start": "npm run build && electron .",
    "package": "npm run build && electron-builder"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^20.11.24",
    "@types/react": "^18.2.61",
    "@types/react-dom": "^18.2.19",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.18",
    "clsx": "^2.1.0",
    "concurrently": "^8.2.2",
    "electron": "^29.1.1",
    "electron-builder": "^24.13.3",
    "lucide-react": "^0.344.0",
    "postcss": "^8.4.35",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tailwind-merge": "^2.2.1",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.3",
    "vite": "^5.1.4",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.localtube.downloader",
    "productName": "LocalTube Downloader",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "asar": false,
    "win": {
      "target": ["nsis", "portable"]
    }
  }
}
